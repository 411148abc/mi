-- builtins.mi — 自举版解释器的内置函数实现（纯计算部分）。
--
-- 只实现不依赖宿主的那些：列表、文本、数学、JSON、显示。
-- 需要宿主（文件/网络/界面/随机数/时钟/输入）的在 host_required() 里登记，
-- 调用时给出 E0301，与 Python 运行时的「宿主不可用」一致。
--
-- 名字与拼写全部来自 规格/glyphs.json（见 tables.mi），因此与 Python 运行时
-- 逐字一致：`len`/`count`/`size`/`⌗` 都归一到 `len`。
--
-- 注意：MI 的关键字/字面量是保留字（out / line / ret / def / node / next /
-- yes / closed / stop / index / kind / map / count / names / args / start），
-- 所以内部一律用 _ 前缀或安全别名。

use "tables.mi"
use "values.mi"
use "json.mi"

-- 说明：规范名 → 是否存在；拼写别名统一归一到规范名。
station builtin_exists(name) {
    ~hit: off
    cycle over builtin_aliases() as pair {
        when pair.alias is name { emit hit: on }
    }
    out value: hit
}

-- 说明：别名归一。
station canonical_builtin(name) {
    ~canonical: name
    cycle over builtin_aliases() as pair {
        when pair.alias is name { emit canonical: pair.canonical }
    }
    out value: canonical
}

-- 说明：所有规范名（spec 顺序，去重）。
station builtin_names() {
    ~acc: []
    cycle over builtin_aliases() as pair {
        when not has(container: acc, value: pair.canonical) {
            emit acc: push(into: acc, value: pair.canonical)
        }
    }
    out value: acc
}

-- 说明：必须靠宿主的内置函数（自举运行时调用会得到 E0301）。
station host_required() {
    out value: [
        "ask", "env", "argv", "serve", "store.read", "store.write", "store.clear",
        "fs.read", "fs.write", "fs.exists", "crypto.sha256", "net.get", "net.post",
        "random", "clock",
        "ui.mount", "ui.clear", "ui.heading", "ui.text", "ui.input", "ui.value",
        "ui.button",
        "view.screen", "view.card", "view.row", "view.list", "view.table",
        "view.progress", "view.badge", "view.map", "view.image", "view.timer",
        "view.after", "view.every", "view.cancel", "view.keep", "view.recall",
        "view.notice", "view.confirm"
    ]
}

-- 说明：该内置是否需要宿主。
station needs_host(name) {
    out value: has(container: host_required(), value: name)
}

-- =============================================================== 实参取值

-- 说明：按位置取实参（缺省 nothing）。
station arg_of(args, _slot) {
    ~acc: nothing
    when _slot below len(value: args) {
        emit acc: at(items: args, index: _slot).value
    }
    out value: acc
}

-- 说明：按标签取实参。
station labelled_arg(args, wanted) {
    ~acc: nothing
    cycle over args as item {
        when item.label isnot nothing {
            when item.label is wanted { emit acc: item.value }
        }
    }
    out value: acc
}

-- 说明：优先按标签、其次按位置取实参。
station pick(args, wanted, _slot) {
    ~by_label: labelled_arg(args: args, wanted: wanted)
    ~acc: by_label
    when by_label is nothing {
        emit acc: arg_of(args: args, _slot: _slot)
    }
    out value: acc
}

-- 说明：文本实参（非文本返回空串，由调用方决定怎么报错）。
station as_text_value(value) {
    ~acc: ""
    when kind(value: value) is "text" { emit acc: value }
    out value: acc
}

-- 说明：把值转成文本（text 内置）。
station text_of(value) {
    ~acc: ""
    ~shape: kind_of(value: value)
    when shape is "nothing" {
        emit acc: ""
    } otherwise when shape is "flag" {
        emit acc: "off"
        when value { emit acc: "on" }
    } otherwise when shape is "number" {
        emit acc: number_text(value: value)
    } otherwise when shape is "text" {
        emit acc: value
    } otherwise {
        emit acc: display_of(value: value)
    }
    out value: acc
}

-- =============================================================== 列表工具

-- 说明：下标规整到 [0, n)（支持负数，越界返回 -1）。
station norm_index(idx, n) {
    ~acc: idx
    when idx below 0 { emit acc: n + idx }
    when acc below 0 { emit acc: -1 }
    when acc atleast n { emit acc: -1 }
    out value: acc
}

-- 说明：at(items, index)，支持负数下标。
station bi_at(items, idx) {
    ~n: len(value: items)
    ~pos: norm_index(idx: idx, n: n)
    ~acc: nothing
    when pos atleast 0 {
        emit acc: at(items: items, index: pos)
    }
    out value: acc
}

-- 说明：slice(items, from, to)。
station bi_slice(items, from_idx, to_idx) {
    ~n: len(value: items)
    ~lo: from_idx
    ~hi: to_idx
    when lo below 0 { emit lo: n + lo }
    when hi below 0 { emit hi: n + hi }
    when lo below 0 { emit lo: 0 }
    when hi above n { emit hi: n }
    ~acc: []
    when lo below hi {
        cycle over span(from: lo, to: hi) as k {
            emit acc: push(into: acc, value: at(items: items, index: k))
        }
    }
    out value: acc
}

-- 说明：span(from, to, step)。
station bi_span(from_idx, to_idx, step) {
    ~acc: []
    ~cursor: from_idx
    ~guard: 0
    cycle while guard below 1000000 {
        ~go: off
        when step above 0 and cursor below to_idx { emit go: on }
        when step below 0 and cursor above to_idx { emit go: on }
        when not go { halt }
        emit acc: push(into: acc, value: cursor)
        emit cursor: cursor + step
        emit guard: guard + 1
    }
    out value: acc
}

-- 说明：list(...) —— 多个实参收成一个列表。
station bi_list(args) {
    ~acc: []
    cycle over args as item {
        emit acc: push(into: acc, value: item.value)
    }
    out value: acc
}

-- 说明：join(items, with)。
station bi_join(items, separator) {
    ~parts: []
    cycle over items as item {
        emit parts: push(into: parts, value: display_of(value: item))
    }
    out value: join(items: parts, with: separator)
}

-- 说明：split(text, at)：手写切分，不依赖字符串库差异。
station bi_split(text_value, separator) {
    ~acc: []
    ~n: len(value: text_value)
    ~m: len(value: separator)
    ~head_at: 0
    ~idx: 0
    ~guard: 0
    cycle while guard below 1000000 {
        ~go: off
        when idx + m atmost n { emit go: on }
        when not go { halt }
        ~window: slice(items: text_value, from: idx, to: idx + m)
        when window is separator {
            emit acc: push(into: acc, value: slice(items: text_value, from: head_at, to: idx))
            emit head_at: idx + m
            emit idx: idx + m
        } otherwise {
            emit idx: idx + 1
        }
        emit guard: guard + 1
    }
    out value: push(into: acc, value: slice(items: text_value, from: head_at, to: n))
}

-- 说明：sort（插入排序，数值/文本都可）。
station bi_sort(items) {
    ~acc: []
    cycle over items as item {
        emit acc: insert_sorted(sorted: acc, item: item)
    }
    out value: acc
}

-- 说明：把 item 插入已排序列表。
station insert_sorted(sorted, item) {
    ~acc: []
    ~placed: off
    cycle over sorted as existing {
        when not placed and item below existing {
            emit acc: push(into: acc, value: item)
            emit placed: on
        }
        emit acc: push(into: acc, value: existing)
    }
    when not placed {
        emit acc: push(into: acc, value: item)
    }
    out value: acc
}

-- 说明：reverse。
station bi_reverse(items) {
    ~acc: []
    ~k: len(value: items) - 1
    cycle over items as item {
        emit acc: push(into: acc, value: at(items: items, index: k))
        emit k: k - 1
    }
    out value: acc
}

-- 说明：min / max（支持 min(a, b, c) 与 min([a, b]) 两种写法）。
station bi_extreme(args, want_min) {
    ~values: []
    cycle over args as item {
        when kind(value: item.value) is "list" {
            cycle over item.value as inner {
                emit values: push(into: values, value: inner)
            }
        } otherwise {
            emit values: push(into: values, value: item.value)
        }
    }
    ~acc: nothing
    when len(value: values) above 0 {
        emit acc: at(items: values, index: 0)
        cycle over values as candidate {
            when want_min and candidate below acc { emit acc: candidate }
            when not want_min and candidate above acc { emit acc: candidate }
        }
    }
    out value: acc
}

-- 说明：绝对值（纯 MI：`-x` 与比较，不用宿主 abs）。
station bi_abs(value) {
    ~acc: value
    when value below 0 { emit acc: 0 - value }
    out value: acc
}

-- 说明：向下取整（纯 MI：`// 1` 对负数也正确）。
station bi_floor(value) {
    out value: value // 1
}

-- 说明：向上取整（纯 MI：先翻号向下取整，再翻回）。
station bi_ceil(value) {
    out value: 0 - ((0 - value) // 1)
}

-- 说明：四舍五入到整数，**半偶**（与 Python 的 round 一致：round(2.5)=2）。
station bi_round(value) {
    ~base: value // 1
    ~frac: value - base
    ~acc: base
    when frac above 0.5 { emit acc: base + 1 }
    when frac is 0.5 {
        ~odd: off
        when not ((base // 2) * 2 is base) { emit odd: on }
        when odd { emit acc: base + 1 }
    }
    out value: acc
}

-- 说明：round(value, digits)：缩放后取整再缩回。
station bi_round_digits(value, digits) {
    ~scale: 10 ** digits
    out value: bi_round(value: value * scale) / scale
}

-- 说明：平方根。只用 `**` 运算符（语言原语，不是宿主内置函数）。
-- 说明：`x ** 0.5` 在 10517 个采样值上与宿主实现只有 22 个末位差，
-- 而牛顿迭代收敛后反而有 2473 个差（收不到正确舍入的最后一位），所以取前者。
station bi_sqrt(value) {
    ~acc: 0
    when value atleast 0 { emit acc: value ** 0.5 }
    out value: acc
}

-- 说明：number(value)：文本转数字（含 0x / 0b），数字原样返回。
station bi_number(value) {
    ~acc: value
    ~shape: kind_of(value: value)
    when shape is "text" {
        ~trimmed: trim_text(text_value: value)
        emit acc: parse_number(text_value: trimmed)
    }
    out value: acc
}

-- 说明：去首尾空白。
station trim_text(text_value) {
    ~head_at: 0
    ~n: len(value: text_value)
    cycle while head_at below n {
        when is_space(ch: at(items: text_value, index: head_at)) {
            emit head_at: head_at + 1
        } otherwise {
            halt
        }
    }
    ~tail_at: n
    cycle while tail_at above head_at {
        when is_space(ch: at(items: text_value, index: tail_at - 1)) {
            emit tail_at: tail_at - 1
        } otherwise {
            halt
        }
    }
    out value: slice(items: text_value, from: head_at, to: tail_at)
}

-- 说明：是否空白字符。
station is_space(ch) {
    ~hit: off
    when ch is " " { emit hit: on }
    when ch is "\t" { emit hit: on }
    when ch is "\n" { emit hit: on }
    when ch is "\r" { emit hit: on }
    out value: hit
}

-- 说明：文本转数字（先试 0x/0b 前缀）。
station parse_number(text_value) {
    ~acc: number(value: text_value)
    when len(value: text_value) above 2 {
        ~head: slice(items: text_value, from: 0, to: 2)
        when head is "0x" or head is "0X" {
            emit acc: parse_radix(text_value: slice(items: text_value, from: 2, to: len(value: text_value)), radix: 16)
        }
        when head is "0b" or head is "0B" {
            emit acc: parse_radix(text_value: slice(items: text_value, from: 2, to: len(value: text_value)), radix: 2)
        }
    }
    out value: acc
}

-- 说明：按进制解析。
station parse_radix(text_value, radix) {
    ~acc: 0
    ~k: 0
    cycle while k below len(value: text_value) {
        ~digit: radix_digit(ch: at(items: text_value, index: k))
        when digit atleast 0 {
            emit acc: acc * radix + digit
        }
        emit k: k + 1
    }
    out value: acc
}

-- 说明：单字符数值（0-15，非法 -1）。
station radix_digit(ch) {
    ~acc: -1
    ~k: 0
    cycle while k below 16 {
        when at(items: "0123456789abcdef", index: k) is ch { emit acc: k }
        when at(items: "0123456789ABCDEF", index: k) is ch { emit acc: k }
        emit k: k + 1
    }
    out value: acc
}

-- 说明：kind 的规范名。
station bi_kind(value) {
    out value: kind_of(value: value)
}

-- 说明：has(container, value)。
station bi_has(container, value) {
    ~hit: off
    ~shape: kind_of(value: container)
    when shape is "text" {
        ~needle: as_text_value(value: value)
        when len(value: needle) is 0 {
            emit hit: on
        } otherwise {
            when contains_text(container: container, needle: needle) { emit hit: on }
        }
    } otherwise when shape is "list" {
        cycle over container as item {
            when equal_of(left: item, right: value) { emit hit: on }
        }
    } otherwise when shape is "assembly" {
        cycle over asm_keys(asm: container) as name {
            when name is as_text_value(value: value) { emit hit: on }
        }
    }
    out value: hit
}

-- 说明：文本是否包含子串。
station contains_text(container, needle) {
    ~parts: bi_split(text_value: container, separator: needle)
    ~hit: off
    when len(value: parts) above 1 { emit hit: on }
    out value: hit
}

-- 说明：keys(assembly)。
station bi_keys(asm) {
    out value: asm_keys(asm: asm)
}

-- 说明：place(assembly, field, value)。
station bi_place(asm, field, value) {
    out value: asm_set(asm: asm, name: field, value: value)
}

-- =============================================================== JSON 支持

-- 说明：json.text(value)：编码成 JSON 文本。
station bi_json_text(value) {
    out value: json_encode(value: value)
}

-- 说明：json.parse(text)：解析 JSON 到内部表示。
station bi_json_parse(text_value) {
    out value: json_decode(text_value: text_value)
}
