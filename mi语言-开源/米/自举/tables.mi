-- 说明：关键字名（spec 顺序）。
station keyword_names() {
    out value: [
        "WIRE",
        "EMIT",
        "DRAW",
        "WHEN",
        "OTHERWISE",
        "STATION",
        "OUT",
        "CYCLE",
        "OVER",
        "AS",
        "IN",
        "WHILE",
        "UNTIL",
        "FOR",
        "HALT",
        "SKIP",
        "RETURN",
        "USE",
        "ASSEMBLY",
        "THEN",
        "DO",
        "BEGIN",
        "END"
    ]
}

-- 说明：字面量名 → token 种类与值。
station literal_kinds() {
    out value: [
        assembly{ name: "TRUE", kind: "flag", value: on },
        assembly{ name: "FALSE", kind: "flag", value: off },
        assembly{ name: "NIL", kind: "nil", value: nothing }
    ]
}

-- 说明：符号字符（非字母数字的拼写字符），词法器用它区分符号与字母。
station symbol_chars() {
    out value: [
        "\t",
        "\n",
        "\r",
        " ",
        "!",
        "\"",
        "#",
        "$",
        "%",
        "&",
        "'",
