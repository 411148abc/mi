        assembly{ s: "×", w: off, k: "OP", v: "TIMES" },
        assembly{ s: "÷", w: off, k: "OP", v: "DIV" },
        assembly{ s: "ø", w: on, k: "LITERAL", v: "NIL" },
        assembly{ s: "⁇", w: off, k: "KW", v: "OTHERWISE" },
        assembly{ s: "←", w: off, k: "KW", v: "RETURN" },
        assembly{ s: "↑", w: off, k: "KW", v: "OUT" },
        assembly{ s: "→", w: off, k: "KW", v: "AS" },
        assembly{ s: "↻", w: off, k: "KW", v: "CYCLE" },
        assembly{ s: "⇐", w: off, k: "KW", v: "USE" },
        assembly{ s: "⇒", w: off, k: "KW", v: "EMIT" },
        assembly{ s: "∀", w: off, k: "KW", v: "FOR" },
        assembly{ s: "∈", w: off, k: "KW", v: "IN" },
        assembly{ s: "∑", w: off, k: "GLYPH", v: "fold" },
        assembly{ s: "∧", w: off, k: "OP", v: "AND" },
        assembly{ s: "∨", w: off, k: "OP", v: "OR" },
