        assembly{ s: "till", w: on, k: "KW", v: "UNTIL" },
        assembly{ s: "true", w: on, k: "LITERAL", v: "TRUE" },
        assembly{ s: "void", w: on, k: "LITERAL", v: "NIL" },
        assembly{ s: "when", w: on, k: "KW", v: "WHEN" },
        assembly{ s: "wire", w: on, k: "KW", v: "WIRE" },
        assembly{ s: "and", w: on, k: "OP", v: "AND" },
        assembly{ s: "def", w: on, k: "KW", v: "STATION" },
        assembly{ s: "div", w: on, k: "OP", v: "DIV" },
        assembly{ s: "end", w: on, k: "KW", v: "END" },
        assembly{ s: "for", w: on, k: "KW", v: "FOR" },
        assembly{ s: "mod", w: on, k: "OP", v: "MOD" },
        assembly{ s: "nil", w: on, k: "LITERAL", v: "NIL" },
        assembly{ s: "not", w: on, k: "OP", v: "NOT" },
        assembly{ s: "obj", w: on, k: "KW", v: "ASSEMBLY" },
        assembly{ s: "off", w: on, k: "LITERAL", v: "FALSE" },
        assembly{ s: "out", w: on, k: "KW", v: "OUT" },
        assembly{ s: "rem", w: on, k: "OP", v: "MOD" },
        assembly{ s: "ret", w: on, k: "KW", v: "RETURN" },
        assembly{ s: "set", w: on, k: "KW", v: "EMIT" },
        assembly{ s: "use", w: on, k: "KW", v: "USE" },
        assembly{ s: "yes", w: on, k: "LITERAL", v: "TRUE" },
        assembly{ s: "!=", w: off, k: "OP", v: "NE" },
        assembly{ s: "&&", w: off, k: "OP", v: "AND" },
        assembly{ s: "**", w: off, k: "OP", v: "POW" },
        assembly{ s: "//", w: off, k: "OP", v: "IDIV" },
        assembly{ s: "<-", w: off, k: "KW", v: "EMIT" },
        assembly{ s: "<<", w: off, k: "KW", v: "EMIT" },
        assembly{ s: "<=", w: off, k: "OP", v: "LE" },
        assembly{ s: "<>", w: off, k: "OP", v: "NE" },
        assembly{ s: "==", w: off, k: "OP", v: "EQ" },
        assembly{ s: ">=", w: off, k: "OP", v: "GE" },
        assembly{ s: "as", w: on, k: "KW", v: "AS" },
        assembly{ s: "do", w: on, k: "KW", v: "DO" },
        assembly{ s: "fn", w: on, k: "KW", v: "STATION" },
        assembly{ s: "if", w: on, k: "KW", v: "WHEN" },
        assembly{ s: "in", w: on, k: "KW", v: "IN" },
        assembly{ s: "is", w: on, k: "OP", v: "EQ" },
        assembly{ s: "no", w: on, k: "LITERAL", v: "FALSE" },
        assembly{ s: "on", w: on, k: "LITERAL", v: "TRUE" },
        assembly{ s: "or", w: on, k: "OP", v: "OR" },
        assembly{ s: "so", w: on, k: "KW", v: "THEN" },
        assembly{ s: "|:", w: off, k: "KW", v: "OTHERWISE" },
        assembly{ s: "||", w: off, k: "OP", v: "OR" },
        assembly{ s: "!", w: off, k: "OP", v: "NOT" },
        assembly{ s: "%", w: off, k: "OP", v: "MOD" },
        assembly{ s: "*", w: off, k: "OP", v: "TIMES" },
        assembly{ s: "+", w: off, k: "OP", v: "PLUS" },
        assembly{ s: "-", w: off, k: "OP", v: "MINUS" },
        assembly{ s: "/", w: off, k: "OP", v: "DIV" },
        assembly{ s: "<", w: off, k: "OP", v: "LT" },
        assembly{ s: ">", w: off, k: "OP", v: "GT" },
        assembly{ s: "?", w: off, k: "KW", v: "WHEN" },
        assembly{ s: "@", w: off, k: "KW", v: "DRAW" },
        assembly{ s: "^", w: off, k: "OP", v: "POW" },
        assembly{ s: "_", w: off, k: "LITERAL", v: "NIL" },
        assembly{ s: "~", w: off, k: "KW", v: "WIRE" },
        assembly{ s: "¤", w: off, k: "KW", v: "ASSEMBLY" },
