-- tables.mi — 自举版解释器的拼写表（由 工具/gen_selfhost_tables.py 生成，勿手改）。
--
-- 数据源与 Python 运行时相同：规格/glyphs.json。这里把它烘焙成 MI 源码，
-- 因为自举版解释器本身运行在 MI 里，读不了 JSON 规格表。
--
-- 公开端口：
--   spellings()        词法匹配表：[{s, w, k, v}]，按拼写长度降序
--   operators()        运算符表：[{name, prec, assoc, arity}]
--   builtin_aliases()  内置函数别名：[{alias, canonical}]
--   keyword_names()    关键字名列表（保持 spec 顺序）
--   literal_kinds()    字面量名 → token 种类：[{name, kind, value}]

-- 说明：词法匹配表：先按长度降序、再按拼写排序，保证最长匹配优先。
station spellings() {
    out value: [
        assembly{ s: "otherwise", w: on, k: "KW", v: "OTHERWISE" },
        assembly{ s: "assembly", w: on, k: "KW", v: "ASSEMBLY" },
        assembly{ s: "continue", w: on, k: "KW", v: "SKIP" },
        assembly{ s: "atleast", w: on, k: "OP", v: "GE" },
        assembly{ s: "channel", w: on, k: "KW", v: "WIRE" },
        assembly{ s: "foreach", w: on, k: "KW", v: "FOR" },
        assembly{ s: "nothing", w: on, k: "LITERAL", v: "NIL" },
        assembly{ s: "perform", w: on, k: "KW", v: "DO" },
        assembly{ s: "require", w: on, k: "KW", v: "USE" },
        assembly{ s: "station", w: on, k: "KW", v: "STATION" },
        assembly{ s: "through", w: on, k: "KW", v: "OVER" },
        assembly{ s: "across", w: on, k: "KW", v: "OVER" },
        assembly{ s: "atmost", w: on, k: "OP", v: "LE" },
        assembly{ s: "called", w: on, k: "KW", v: "AS" },
        assembly{ s: "closed", w: on, k: "LITERAL", v: "FALSE" },
        assembly{ s: "equals", w: on, k: "OP", v: "EQ" },
        assembly{ s: "finish", w: on, k: "KW", v: "END" },
        assembly{ s: "import", w: on, k: "KW", v: "USE" },
        assembly{ s: "inside", w: on, k: "KW", v: "IN" },
        assembly{ s: "intdiv", w: on, k: "OP", v: "IDIV" },
        assembly{ s: "record", w: on, k: "KW", v: "ASSEMBLY" },
        assembly{ s: "repeat", w: on, k: "KW", v: "CYCLE" },
        assembly{ s: "return", w: on, k: "KW", v: "RETURN" },
        assembly{ s: "struct", w: on, k: "KW", v: "ASSEMBLY" },
        assembly{ s: "whilst", w: on, k: "KW", v: "WHILE" },
        assembly{ s: "above", w: on, k: "OP", v: "GT" },
        assembly{ s: "begin", w: on, k: "KW", v: "BEGIN" },
        assembly{ s: "below", w: on, k: "OP", v: "LT" },
        assembly{ s: "break", w: on, k: "KW", v: "HALT" },
        assembly{ s: "cycle", w: on, k: "KW", v: "CYCLE" },
        assembly{ s: "false", w: on, k: "LITERAL", v: "FALSE" },
        assembly{ s: "isnot", w: on, k: "OP", v: "NE" },
        assembly{ s: "minus", w: on, k: "OP", v: "MINUS" },
        assembly{ s: "power", w: on, k: "OP", v: "POW" },
        assembly{ s: "start", w: on, k: "KW", v: "BEGIN" },
        assembly{ s: "times", w: on, k: "OP", v: "TIMES" },
        assembly{ s: "until", w: on, k: "KW", v: "UNTIL" },
        assembly{ s: "while", w: on, k: "KW", v: "WHILE" },
        assembly{ s: "yield", w: on, k: "KW", v: "OUT" },
        assembly{ s: "draw", w: on, k: "KW", v: "DRAW" },
        assembly{ s: "else", w: on, k: "KW", v: "OTHERWISE" },
        assembly{ s: "emit", w: on, k: "KW", v: "EMIT" },
        assembly{ s: "func", w: on, k: "KW", v: "STATION" },
        assembly{ s: "gate", w: on, k: "KW", v: "WHEN" },
        assembly{ s: "give", w: on, k: "KW", v: "OUT" },
        assembly{ s: "halt", w: on, k: "KW", v: "HALT" },
        assembly{ s: "idiv", w: on, k: "OP", v: "IDIV" },
        assembly{ s: "line", w: on, k: "KW", v: "WIRE" },
        assembly{ s: "loop", w: on, k: "KW", v: "CYCLE" },
        assembly{ s: "next", w: on, k: "KW", v: "SKIP" },
        assembly{ s: "node", w: on, k: "KW", v: "STATION" },
        assembly{ s: "none", w: on, k: "LITERAL", v: "NIL" },
        assembly{ s: "open", w: on, k: "LITERAL", v: "TRUE" },
        assembly{ s: "othw", w: on, k: "KW", v: "OTHERWISE" },
        assembly{ s: "over", w: on, k: "KW", v: "OVER" },
        assembly{ s: "plus", w: on, k: "OP", v: "PLUS" },
