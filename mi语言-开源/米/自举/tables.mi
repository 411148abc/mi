        assembly{ s: "≠", w: off, k: "OP", v: "NE" },
        assembly{ s: "≡", w: off, k: "GLYPH", v: "map" },
        assembly{ s: "≤", w: off, k: "OP", v: "LE" },
        assembly{ s: "≥", w: off, k: "OP", v: "GE" },
        assembly{ s: "⊤", w: off, k: "LITERAL", v: "TRUE" },
        assembly{ s: "⊥", w: off, k: "LITERAL", v: "FALSE" },
        assembly{ s: "⋔", w: off, k: "GLYPH", v: "filter" },
