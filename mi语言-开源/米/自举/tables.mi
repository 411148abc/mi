-- 说明：运算符：prec 越小结合越紧；arity 为 infix 或 prefix。
station operators() {
    out value: [
        assembly{ name: "OR", prec: 10, assoc: "left", arity: "infix" },
        assembly{ name: "AND", prec: 20, assoc: "left", arity: "infix" },
        assembly{ name: "NOT", prec: 80, assoc: "right", arity: "prefix" },
        assembly{ name: "EQ", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "NE", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "LT", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "LE", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "GT", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "GE", prec: 40, assoc: "none", arity: "infix" },
        assembly{ name: "PLUS", prec: 50, assoc: "left", arity: "infix" },
        assembly{ name: "MINUS", prec: 50, assoc: "left", arity: "infix" },
        assembly{ name: "TIMES", prec: 60, assoc: "left", arity: "infix" },
        assembly{ name: "DIV", prec: 60, assoc: "left", arity: "infix" },
        assembly{ name: "IDIV", prec: 60, assoc: "left", arity: "infix" },
        assembly{ name: "MOD", prec: 60, assoc: "left", arity: "infix" },
        assembly{ name: "POW", prec: 70, assoc: "right", arity: "infix" }
    ]
}

