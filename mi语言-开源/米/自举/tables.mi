        ">",
        "?",
        "@",
        "[",
        "\\",
        "]",
        "^",
        "_",
        "`",
        "{",
        "|",
        "}",
        "~",
        "¤",
        "§",
        "¬",
        "»",
        "×",
        "÷",
        "⁇",
        "←",
        "↑",
        "→",
        "↻",
        "⇐",
        "⇒",
        "∀",
        "∈",
        "∑",
        "∧",
        "∨",
        "∫",
        "≠",
        "≡",
        "≤",
